{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medical Docs — contrato de fatos e relatório",
  "description": "Versão 0.1.0, em revisão. Uso acadêmico com documentos sintéticos.",
  "oneOf": [
    {
      "$ref": "#/$defs/facts_request"
    },
    {
      "$ref": "#/$defs/audit_report"
    }
  ],
  "$defs": {
    "facts_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol_id",
        "protocol_version",
        "reference_date",
        "documents",
        "facts",
        "conflicts",
        "warnings"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "protocol_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "protocol_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "reference_date": {
          "type": "string",
          "format": "date"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "audit_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol_id",
        "protocol_version",
        "reference_date",
        "status",
        "conclusion",
        "findings",
        "trace",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "protocol_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "protocol_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "reference_date": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": [
            "conforme",
            "pendente",
            "nao_conforme",
            "nao_aplicavel"
          ]
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          },
          "minItems": 1
        },
        "trace": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace_step"
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "type": {
          "enum": [
            "cns",
            "identidade",
            "comprovante_residencia",
            "lme",
            "prescricao",
            "formulario_asma",
            "ter",
            "exame",
            "relato_medico",
            "outro"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "page",
        "excerpt"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "unit"
          ],
          "properties": {
            "amount": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value",
        "state",
        "evidence"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "confirmado",
            "desconhecido",
            "contraditorio"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "confirmado"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/value"
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "desconhecido"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "contraditorio"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "evidence": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "alternatives"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "evidence"
            ],
            "properties": {
              "value": {
                "$ref": "#/$defs/value"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                },
                "minItems": 1
              }
            }
          },
          "minItems": 2
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "edition",
        "locator",
        "url"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "conclusion",
        "premises",
        "source",
        "evidence",
        "status"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "premises": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "minItems": 1
        },
        "source": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "status": {
          "enum": [
            "conforme",
            "pendente",
            "nao_conforme",
            "nao_aplicavel"
          ]
        }
      }
    },
    "trace_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "layer",
        "depends_on",
        "status"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "layer": {
          "enum": [
            "intermediaria",
            "documental"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "minItems": 1
        },
        "status": {
          "enum": [
            "conforme",
            "pendente",
            "nao_conforme",
            "nao_aplicavel"
          ]
        }
      }
    }
  }
}
