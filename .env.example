# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for OpenAI ChatGPT API calls. Keep this value only on the server.
OPENAI_API_KEY=

# Acesso local inicial (altere em produção).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=teste123
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@medicaldocs.local

# Credenciais do aplicativo cadastrado no gov.br (OAuth 2.0).
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_REDIRECT_URI=http://localhost:3000/api/auth/govbr/callback
GOVBR_SCOPE=openid email profile

# Catálogo oficial usado para localizar a página da patologia e o PDF "RESUMO".
PCDT_CATALOG_URL=https://www.saude.sc.gov.br/index.php/pt/assistencia-farmaceutica-diaf/componente-especializado-da-assistencia-farmaceutica-ceaf/protocolos-clinicos-ter-resumos-e-formularios

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
